
export component TextSizeOption inherits Rectangle {
    in property <int> size_value: 24;
    in property <bool> is_active: false;
    callback clicked;

    width: 34px;
    height: 28px;
    border-radius: 4px;
    background: root.is_active ? #E8F0FE : (touch.has-hover ? #F1F3F4 : transparent);

    Text {
        text: "T";
        font-size: root.size_value * 1px;
        color: #202124;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
