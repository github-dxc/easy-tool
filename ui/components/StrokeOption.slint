
export component StrokeOption inherits Rectangle {
    in property <int> stroke_value: 3;
    in property <bool> is_active: false;
    callback clicked;

    width: 34px;
    height: 28px;
    border-radius: 4px;
    background: root.is_active ? #E8F0FE : (touch.has-hover ? #F1F3F4 : transparent);

    Rectangle {
        width: 20px;
        height: root.stroke_value * 1px;
        border-radius: root.stroke_value * 1px / 2;
        background: #202124;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
