import { ScrollView } from "std-widgets.slint";

// 两个紧凑工具共用按钮、标题栏和文本区，统一颜色与交互反馈。
export component CompactButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> icon: false;
    out property <bool> active: touch.has-hover || focus.has-focus;
    callback clicked();
    width: root.icon ? 26px : 48px;
    height: 24px;
    border-radius: 5px;
    background: !root.enabled ? transparent : root.primary
        ? (touch.pressed ? #2D467B : touch.has-hover ? #4666A5 : #3B5998)
        : (touch.pressed ? #E9EDF3 : touch.has-hover ? #F0F3F7 : transparent);
    border-width: focus.has-focus ? 1px : 0px;
    border-color: #9BAFD2;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    Text {
        text: root.text;
        font-size: root.icon ? 18px : 12px;
        color: !root.enabled ? #B9BEC7 : root.primary ? #FFFFFF : #647084;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CompactHeader inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    callback close();
    callback drag();
    height: 28px;
    background: transparent;
    // 仅标题区域触发原生拖动，避免选中文本或点击按钮时移动窗口。
    TouchArea {
        width: parent.width - 34px;
        moved => { if self.pressed { root.drag(); } }
    }
    Text {
        x: 0px;
        width: 110px;
        text: root.title;
        font-size: 14px;
        font-weight: 600;
        color: #273244;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
    Text {
        x: 110px;
        width: max(0px, parent.width - 150px);
        text: root.caption;
        font-size: 11px;
        color: #939BA8;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    CompactButton {
        x: parent.width - self.width;
        y: 2px;
        text: "×";
        icon: true;
        accessible-label: "关闭";
        clicked => { root.close(); }
    }
}

export component CompactTextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> read-only: false;
    callback edited(text: string);
    forward-focus: input;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus && !root.read-only ? #A6B7D2 : #E9ECF1;
    background: root.read-only ? #F6F8FC : #FCFCFD;
    clip: true;
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "复制";
                enabled: root.text != "";
                activated => { input.copy(); }
            }
            MenuItem {
                title: "粘贴";
                enabled: !root.read-only;
                activated => { input.paste(); }
            }
            MenuItem {
                title: "全选";
                enabled: root.text != "";
                activated => { input.select-all(); }
            }
        }
        scroll := ScrollView {
            x: 9px;
            y: 8px;
            width: parent.width - 18px;
            height: parent.height - 16px;
            viewport-width: self.visible-width;
            viewport-height: max(self.visible-height, input.preferred-height);
            input := TextInput {
                width: scroll.visible-width;
                height: max(scroll.visible-height, self.preferred-height);
                text <=> root.text;
                read-only: root.read-only;
                single-line: false;
                wrap: word-wrap;
                font-size: 13px;
                color: root.read-only ? #3B5998 : #303A49;
                selection-background-color: #DCE6F7;
                selection-foreground-color: #243E70;
                page-height: scroll.visible-height;
                accessible-label: root.placeholder;
                edited => { root.edited(self.text); }
                // 输入长文本时跟随光标滚动，保持正在编辑的行可见。
                cursor-position-changed(position) => {
                    if position.y + scroll.viewport-y < 0px {
                        scroll.viewport-y = -position.y;
                    } else if position.y + scroll.viewport-y > scroll.visible-height - 20px {
                        scroll.viewport-y = min(0px, scroll.visible-height - position.y - 20px);
                    }
                }
            }
        }
    }
    Text {
        x: 9px;
        y: 8px;
        width: parent.width - 18px;
        text: root.text == "" && input.preedit-text == "" ? root.placeholder : "";
        font-size: 13px;
        color: #A1A8B4;
        wrap: word-wrap;
        vertical-alignment: top;
        accessible-role: none;
    }
}
