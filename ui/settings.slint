import { Button, LineEdit, Switch } from "std-widgets.slint";
import "../assets/font/AlibabaPuHuiTi-3-55-Regular.ttf";

export component SettingsWindow inherits Window {
    width: 720px;
    height: 560px;
    title: "设置";
    default-font-family: "Alibaba PuHuiTi 3.0";

    in-out property <bool> copy_timestamp_enabled: true;
    in-out property <bool> clipboard_history_enabled: true;
    in-out property <bool> screenshot_enabled: true;
    in-out property <bool> image_recognition_enabled: true;
    in-out property <bool> text_translation_enabled: false;
    in-out property <bool> tencent_backend_enabled: false;
    in-out property <string> tencent_secret_id: "";
    in-out property <string> tencent_secret_key: "";
    in-out property <string> image_recognition_model_dir: "";
    in-out property <string> text_translation_zh_to_en_model_dir: "";
    in-out property <string> text_translation_en_to_zh_model_dir: "";
    in-out property <string> text_translation_debounce_seconds: "1";
    in-out property <string> last_valid_text_translation_debounce_seconds: "1";

    callback browse_image_recognition_model_dir();
    callback browse_text_translation_zh_to_en_model_dir();
    callback browse_text_translation_en_to_zh_model_dir();
    callback apply_settings(
        copy_timestamp_enabled: bool,
        clipboard_history_enabled: bool,
        screenshot_enabled: bool,
        image_recognition_enabled: bool,
        text_translation_enabled: bool,
        tencent_backend_enabled: bool,
        tencent_secret_id: string,
        tencent_secret_key: string,
        image_recognition_model_dir: string,
        text_translation_debounce_seconds: string
    );
    callback close_requested();

    Rectangle {
        background: #EEF3F8;

        Flickable {
            width: parent.width;
            height: parent.height;
            viewport-width: parent.width;
            viewport-height: content.height;

            content := Rectangle {
                width: parent.width;
                height: 980px;

                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;

                    Rectangle {
                        background: #FFFFFF;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #D8E1EB;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            Text {
                                text: "快捷键配置";
                                color: #1A2430;
                                font-size: 18px;
                                font-weight: 800;
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "显示时间戳 - Ctrl+C";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Switch {
                                    checked <=> root.copy_timestamp_enabled;
                                    text: self.checked ? "已开启" : "已关闭";
                                    toggled => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "复制历史 - Ctrl+Shift+C";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Switch {
                                    checked <=> root.clipboard_history_enabled;
                                    text: self.checked ? "已开启" : "已关闭";
                                    toggled => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "截图快捷键 - Alt+Shift+Z";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Switch {
                                    checked <=> root.screenshot_enabled;
                                    text: self.checked ? "已开启" : "已关闭";
                                    toggled => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "图像识别";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Switch {
                                    checked <=> root.image_recognition_enabled;
                                    text: self.checked ? "已开启" : "已关闭";
                                    toggled => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "文本翻译 - Ctrl+C";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Switch {
                                    checked <=> root.text_translation_enabled;
                                    text: self.checked ? "已开启" : "已关闭";
                                    toggled => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "OCR/NLP配置";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Switch {
                                    checked <=> root.tencent_backend_enabled;
                                    text: self.checked ? "本地模型" : "腾讯API";
                                    toggled => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "翻译防抖时间（秒）";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                LineEdit {
                                    text <=> root.text_translation_debounce_seconds;
                                    placeholder-text: "默认 1";
                                    edited(new_text) => {
                                        if (new_text != "" && new_text.is-float()) {
                                            root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                            root.last_valid_text_translation_debounce_seconds = new_text;
                                        } else {
                                            root.text_translation_debounce_seconds = root.last_valid_text_translation_debounce_seconds;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        background: #FFFFFF;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #D8E1EB;
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 18px;

                            Text {
                                text: "OCR/NLP配置";
                                color: #1A2430;
                                font-size: 18px;
                                font-weight: 800;
                            }

                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "腾讯访问密钥";
                                    color: #223041;
                                    font-size: 14px;
                                    font-weight: 700;
                                }

                                LineEdit {
                                    text <=> root.tencent_secret_id;
                                    placeholder-text: "SecretId";
                                    edited(_) => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }

                                LineEdit {
                                    text <=> root.tencent_secret_key;
                                    placeholder-text: "SecretKey";
                                    edited(_) => {
                                        root.apply_settings(root.copy_timestamp_enabled, root.clipboard_history_enabled, root.screenshot_enabled, root.image_recognition_enabled, root.text_translation_enabled, root.tencent_backend_enabled, root.tencent_secret_id, root.tencent_secret_key, root.image_recognition_model_dir, root.text_translation_debounce_seconds);
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "图像识别模型目录";
                                    color: #223041;
                                    font-size: 14px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    LineEdit {
                                        text <=> root.image_recognition_model_dir;
                                        read-only: true;
                                        placeholder-text: "请选择模型文件夹";
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        width: 88px;
                                        text: "打开";
                                        clicked => {
                                            root.browse_image_recognition_model_dir();
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "中译英模型目录";
                                    color: #223041;
                                    font-size: 14px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    LineEdit {
                                        text <=> root.text_translation_zh_to_en_model_dir;
                                        read-only: true;
                                        placeholder-text: "请选择模型文件夹";
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        width: 88px;
                                        text: "打开";
                                        clicked => {
                                            root.browse_text_translation_zh_to_en_model_dir();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "英译中模型目录";
                                    color: #223041;
                                    font-size: 14px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    LineEdit {
                                        text <=> root.text_translation_en_to_zh_model_dir;
                                        read-only: true;
                                        placeholder-text: "请选择模型文件夹";
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        width: 88px;
                                        text: "打开";
                                        clicked => {
                                            root.browse_text_translation_en_to_zh_model_dir();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
