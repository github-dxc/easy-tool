import { ComboBox, LineEdit, Switch } from "std-widgets.slint";
import "../assets/font/AlibabaPuHuiTi-3-55-Regular.ttf";

export component SettingsWindow inherits Window {
    // 将页面定义的逻辑尺寸提供给原生窗口，首次显示前即可准确定位。
    out property <length> initial_width: root.width;
    out property <length> initial_height: root.height;
    width: 720px;
    height: 560px;
    title: "设置";
    default-font-family: "Alibaba PuHuiTi 3.0";

    in-out property <int> copy_mode_index: 1;
    in-out property <bool> clipboard_history_enabled: true;
    in-out property <bool> copy_mode_shortcut_enabled: false;
    in-out property <string> tencent_secret_id: "";
    in-out property <string> tencent_secret_key: "";
    in-out property <string> text_translation_debounce_seconds: "1";
    in-out property <string> last_valid_text_translation_debounce_seconds: "1";

    callback apply_settings();
    callback close_requested();

    Rectangle {
        background: #EEF3F8;

        Flickable {
            width: parent.width;
            height: parent.height;
            viewport-width: parent.width;
            viewport-height: content.height;

            content := Rectangle {
                width: parent.width;
                height: 560px;

                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;

                    Rectangle {
                        background: #FFFFFF;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #D8E1EB;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            Text {
                                text: "快捷键配置";
                                color: #1A2430;
                                font-size: 18px;
                                font-weight: 800;
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "复制功能";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 50%;
                                }

                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: ["关闭", "转换时间戳", "翻译文本"];
                                    current-index <=> root.copy_mode_index;
                                    selected(_) => { root.apply_settings(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "复制历史 - Ctrl+Shift+C";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 50%;
                                }

                                Switch {
                                    checked <=> root.clipboard_history_enabled;
                                    text: self.checked ? "已开启" : "已关闭";
                                    toggled => {
                                        root.apply_settings();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "切换复制功能 - Ctrl+Alt+X";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 50%;
                                }

                                Switch {
                                    checked <=> root.copy_mode_shortcut_enabled;
                                    text: self.checked ? "已开启" : "已关闭";
                                    toggled => { root.apply_settings(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "翻译防抖时间（秒）";
                                    color: #223041;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 50%;
                                }

                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.text_translation_debounce_seconds;
                                    placeholder-text: "默认 1";
                                    edited(new_text) => {
                                        if (new_text != "" && new_text.is-float()) {
                                            root.apply_settings();
                                            root.last_valid_text_translation_debounce_seconds = new_text;
                                        } else {
                                            root.text_translation_debounce_seconds = root.last_valid_text_translation_debounce_seconds;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        background: #FFFFFF;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #D8E1EB;
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 18px;

                            Text {
                                text: "腾讯云翻译 API 配置";
                                color: #1A2430;
                                font-size: 18px;
                                font-weight: 800;
                            }

                            VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "腾讯访问密钥";
                                    color: #223041;
                                    font-size: 14px;
                                    font-weight: 700;
                                }

                                LineEdit {
                                    text <=> root.tencent_secret_id;
                                    placeholder-text: "SecretId";
                                    edited(_) => {
                                        root.apply_settings();
                                    }
                                }

                                LineEdit {
                                    text <=> root.tencent_secret_key;
                                    placeholder-text: "SecretKey";
                                    edited(_) => {
                                        root.apply_settings();
                                    }
                                }
                            }

                        }
                    }
                }
            }
        }
    }
}
