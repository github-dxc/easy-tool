import { CompactButton, CompactHeader, CompactTextArea } from "components/compact.slint";
import "../assets/font/AlibabaPuHuiTi-3-55-Regular.ttf";

export component TextTranslationWindow inherits Window {
    // 页面逻辑尺寸供原生窗口在首次显示前居中定位。
    out property <length> initial_width: root.width;
    out property <length> initial_height: root.height;
    width: 360px;
    height: 300px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "文本翻译";
    default-font-family: "Alibaba PuHuiTi 3.0";
    forward-focus: source-editor;

    in-out property <string> source_text: "";
    in-out property <string> translated_text: "";
    in-out property <bool> translating: false;
    in-out property <bool> copied: false;
    // 关闭或重新打开时递增，使等待原生窗口创建的旧显示任务失效。
    in-out property <int> display_generation: 0;
    callback source_text_edited(text: string);
    callback copy_result();
    callback close_window();
    callback move_window();

    changed translated_text => { root.copied = false; }
    changed source_text => { root.copied = false; }

    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.close_window(); return accept; }
            return reject;
        }
        Rectangle {
            background: #FFFFFF;
            border-radius: 8px;
            border-width: 1px;
            border-color: #D1D1D1;
            clip: true;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                CompactHeader {
                    title: "文本翻译";
                    caption: "中英互译";
                    close => { root.close_window(); }
                    drag => { root.move_window(); }
                }
                HorizontalLayout {
                    height: 20px;
                    Text {
                        text: "原文";
                        font-size: 11px;
                        color: #939BA8;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    CompactButton {
                        text: "清空";
                        height: 20px;
                        enabled: root.source_text != "";
                        clicked => {
                            root.source_text = "";
                            root.translated_text = "";
                            root.source_text_edited("");
                            source-editor.focus();
                        }
                    }
                }
                source-editor := CompactTextArea {
                    height: 80px;
                    text <=> root.source_text;
                    placeholder: "输入或粘贴文本，自动翻译";
                    edited(text) => { root.source_text_edited(text); }
                }
                HorizontalLayout {
                    height: 20px;
                    Text {
                        text: root.translating ? "译文 · 翻译中…" : "译文";
                        font-size: 11px;
                        color: root.translating ? #3B5998 : #939BA8;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    CompactButton {
                        text: root.copied ? "已复制" : "复制";
                        height: 20px;
                        enabled: root.translated_text != "" && !root.translating;
                        clicked => { root.copy_result(); }
                    }
                }
                CompactTextArea {
                    vertical-stretch: 1;
                    read-only: true;
                    text: root.translated_text;
                    placeholder: root.translating ? "正在翻译，请稍候…" : "译文会显示在这里";
                }
            }
        }
    }
}
