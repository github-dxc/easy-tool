import { TextEdit } from "std-widgets.slint";
import "../assets/font/NotoSans.ttf";

export component TextTranslationWindow inherits Window {
    width: 620px;
    height: 520px;
    always-on-top: true;
    title: "翻译文本";
    default-font-family: "Noto Sans";

    in-out property <string> source_text: "";
    in-out property <string> translated_text: "";
    in-out property <bool> translating: false;
    callback source_text_edited(text: string);

    Rectangle {
        background: #F6F7F9;

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            Rectangle {
                height: (parent.height - 40px) / 2;
                background: #FFFFFF;
                border-color: #D9DDE3;
                border-width: 1px;
                border-radius: 6px;
                clip: true;

                TextEdit {
                    width: parent.width;
                    height: parent.height;
                    wrap: word-wrap;
                    font-size: 14px;
                    text <=> root.source_text;
                    edited(text) => {
                        root.source_text_edited(text);
                    }
                }
            }

            Rectangle {
                height: (parent.height - 40px) / 2;
                background: #FFFFFF;
                border-color: #D9DDE3;
                border-width: 1px;
                border-radius: 6px;
                clip: true;

                TextEdit {
                    width: parent.width;
                    height: parent.height;
                    read-only: true;
                    wrap: word-wrap;
                    font-size: 14px;
                    text: root.translated_text;
                }

                if root.translating && root.translated_text == "": Text {
                    text: "翻译中...";
                    color: #6B7280;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
