import "../assets/font/AlibabaPuHuiTi-3-55-Regular.ttf";

component ToolTile inherits Rectangle {
    in property <image> icon;
    in property <string> name: "";
    callback clicked;

    width: 78px;
    height: 116px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? #A8C7FA : #DCE3EA;
    background: touch.pressed ? #E8F0FE : touch.has-hover ? #F3F7FC : #FFFFFF;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Image {
        width: 64px;
        height: 64px;
        x: (parent.width - self.width) / 2;
        y: 14px;
        source: root.icon;
        image-fit: contain;
    }

    Text {
        width: parent.width;
        height: 28px;
        x: 0px;
        y: 82px;
        text: root.name;
        color: #1F2A33;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SettingsButton inherits Rectangle {
    callback clicked;

    width: 34px;
    height: 34px;
    background: transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: "⚙";
        color: touch.pressed ? #2F3A45 : touch.has-hover ? #42515F : #506071;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: touch.pressed ? 0.65 : 1.0;
    }
}

export component HomeWindow inherits Window {
    width: 400px;
    height: 300px;
    title: "easy-tool";
    default-font-family: "Alibaba PuHuiTi 3.0";

    callback open_time_trans();
    callback open_clipboard_history();
    callback open_text_translation();
    callback open_file_preview();
    callback open_settings();

    Rectangle {
        background: #EEF2F6;

        VerticalLayout {
            padding: 24px;
            spacing: 18px;

            Text {
                text: "easy-tool";
                color: #16202A;
                font-size: 30px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Flickable {
                viewport-height: tools.height;

                tools := Rectangle {
                    width: parent.width;
                    height: 116px;
                    background: transparent;

                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        alignment: center;

                        ToolTile {
                            icon: @image-url("../assets/icons/timestamp.png");
                            name: "时间戳转换";
                            clicked => {
                                root.open_time_trans();
                            }
                        }

                        ToolTile {
                            icon: @image-url("../assets/icons/copy_history.png");
                            name: "复制历史";
                            clicked => {
                                root.open_clipboard_history();
                            }
                        }

                        ToolTile {
                            icon: @image-url("../assets/icons/translation.png");
                            name: "文本翻译";
                            clicked => {
                                root.open_text_translation();
                            }
                        }

                        ToolTile {
                            icon: @image-url("../assets/icons/file_preview.png");
                            name: "文件预览";
                            clicked => {
                                root.open_file_preview();
                            }
                        }
                    }
                }
            }
        }

        SettingsButton {
            x: parent.width - self.width - 20px;
            y: 18px;
            clicked => {
                root.open_settings();
            }
        }
    }
}
