import "../assets/font/AlibabaPuHuiTi-3-55-Regular.ttf";

component ToolTile inherits Rectangle {
    in property <image> icon;
    in property <string> name: "";
    callback clicked;

    width: 78px;
    height: 108px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? #A8C7FA : #DCE3EA;
    background: touch.pressed ? #E8F0FE : touch.has-hover ? #F3F7FC : #FFFFFF;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Image {
        width: 52px;
        height: 52px;
        x: (parent.width - self.width) / 2;
        y: 12px;
        source: root.icon;
        image-fit: contain;
    }

    Text {
        width: parent.width;
        height: 34px;
        x: 0px;
        y: 68px;
        text: root.name;
        color: #1F2A33;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SettingsButton inherits Rectangle {
    callback clicked;

    width: 34px;
    height: 34px;
    background: transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: "⚙";
        color: touch.pressed ? #2F3A45 : touch.has-hover ? #42515F : #506071;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: touch.pressed ? 0.65 : 1.0;
    }
}

export component HomeWindow inherits Window {
    // 将页面定义的逻辑尺寸提供给原生窗口，首次显示前即可准确定位。
    out property <length> initial_width: root.width;
    out property <length> initial_height: root.height;
    width: 400px;
    height: 280px;
    title: "easy-tool";
    default-font-family: "Alibaba PuHuiTi 3.0";

    callback open_time_trans();
    callback open_clipboard_history();
    callback open_text_translation();
    callback open_settings();

    Rectangle {
        background: #EEF2F6;

        VerticalLayout {
            padding: 24px;
            alignment: center;
            spacing: 18px;

            Text {
                text: "easy-tool";
                color: #16202A;
                font-size: 30px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                ToolTile {
                    icon: @image-url("../assets/icons/timestamp.png");
                    name: "时间转换";
                    clicked => { root.open_time_trans(); }
                }

                ToolTile {
                    icon: @image-url("../assets/icons/copy_history.png");
                    name: "复制历史";
                    clicked => { root.open_clipboard_history(); }
                }

                ToolTile {
                    icon: @image-url("../assets/icons/translation.png");
                    name: "文本翻译";
                    clicked => { root.open_text_translation(); }
                }
            }
        }

        SettingsButton {
            x: parent.width - self.width - 20px;
            y: 18px;
            clicked => { root.open_settings(); }
        }
    }
}
