import { Button, TextEdit } from "std-widgets.slint";
import "../assets/font/AlibabaPuHuiTi-3-55-Regular.ttf";

export component FilePreviewWindow inherits Window {
    width: 820px;
    height: 620px;
    title: root.file_name != "" ? root.file_name : "图片预览";
    default-font-family: "Alibaba PuHuiTi 3.0";

    in-out property <string> file_path: "";
    in-out property <string> file_name: "";
    in-out property <string> status_text: "";
    in-out property <image> image_content;
    in-out property <bool> has_content: false;
    in-out property <int> image_width: 0;
    in-out property <int> image_height: 0;
    in-out property <bool> ocr_panel_visible: false;
    in-out property <string> ocr_text: "";
    in-out property <string> ocr_status_text: "";

    callback close_preview();
    callback open_file();
    callback toggle_ocr_panel();

    Rectangle {
        background: #F6F7F9;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                Rectangle {
                    background: #FFFFFF;
                    border-color: #D9DDE3;
                    border-width: 1px;
                    border-radius: 6px;
                    clip: true;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    if !root.has_content: VerticalLayout {
                        alignment: center;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 0px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            Button {
                                width: 96px;
                                height: 32px;
                                text: "Open";
                                clicked => {
                                    root.open_file();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                        }

                        Text {
                            text: root.status_text;
                            color: #6B7280;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                    }

                    if root.has_content: Rectangle {
                        background: #ECEFF3;

                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.image_content;
                            image-fit: contain;
                        }
                    }

                }

                if root.has_content: Rectangle {
                    width: 36px;
                    vertical-stretch: 1;
                    background: transparent;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        padding: 6px;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #E5E7EB;
                            background: root.ocr_panel_visible ? #DBEAFE : (translation_btn.has-hover ? #F3F4F6 : transparent);

                            translation_btn := TouchArea {
                                clicked => {
                                    root.toggle_ocr_panel();
                                }
                            }

                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../assets/icons/translation-32.png");
                                image-fit: contain;
                                colorize: root.ocr_panel_visible ? #2563EB : #6B7280;
                            }
                        }
                    }
                }

                if root.has_content && root.ocr_panel_visible: Rectangle {
                    width: 320px;
                    background: #FFFFFF;
                    border-color: #D9DDE3;
                    border-width: 1px;
                    border-radius: 6px;
                    clip: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            text: root.ocr_status_text;
                            color: #4B5563;
                            font-size: 13px;
                        }

                        TextEdit {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            read-only: true;
                            wrap: word-wrap;
                            font-size: 14px;
                            text: root.ocr_text;
                        }
                    }
                }
            }
        }
    }
}
